# Copy to .env (git-ignored) and adjust.
# Read by compose.yaml (PostgreSQL container) and by the application (JDBC connection).
# Tests don't use it: they start their own PostgreSQL with Testcontainers.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=account_verification
POSTGRES_USER=axon
POSTGRES_PASSWORD=change-me
# Session timeouts set on every pooled connection; read by the application only (PostgreSQL durations, 0 disables).
POSTGRES_LOCK_TIMEOUT=5s
POSTGRES_IDLE_IN_TRANSACTION_TIMEOUT=60s
